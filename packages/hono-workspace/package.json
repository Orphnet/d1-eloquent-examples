{
  "name": "@example/hono-workspace",
  "version": "0.1.0",
  "description": "d1-eloquent example: multi-tenant workspace platform on Hono + Cloudflare Workers",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "d1-eloquent migrate",
    "db:rollback": "d1-eloquent rollback",
    "db:fresh": "d1-eloquent fresh --force",
    "db:seed": "d1-eloquent seed",
    "db:status": "d1-eloquent status",
    "db:make:migration": "d1-eloquent make:migration",
    "db:generate": "d1-eloquent generate"
  },
  "dependencies": {
    "@orphnet/d1-eloquent": "^0.1.0-beta.1",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.18",
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "vitest": "~3.0.0",
    "wrangler": "^4.17.0"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.1.0"
  }
}
